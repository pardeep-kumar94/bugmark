# ─── Site ──────────────────────────────────────────────────────
# Public URL of this site (no trailing slash). Used for canonical URLs, sitemap, structured data, and is
# written into the downloadable extension (website link, uninstall survey, install detection).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
# Optional: extension ID. Defaults to the pinned ID of the downloadable build (lib/release.json).
NEXT_PUBLIC_EXTENSION_ID=

# ─── Website analytics — Firebase (Google Analytics 4) ─────────
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration → Config
# (enable Google Analytics for the project so measurementId is present). Leave empty to disable analytics.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# opt-out (default): analytics on, banner lets visitors decline · opt-in: nothing stored until visitors accept (EU/UK)
NEXT_PUBLIC_ANALYTICS_CONSENT=opt-out
# true → log every event to the browser console and show it in GA4 DebugView
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# ─── Extension analytics (used by `npm run package:extension`) ──
# Same GA4 property as above: GA Admin → Data streams → your web stream → Measurement ID, and
# "Measurement Protocol API secrets" → Create.
BUGMARK_GA_MEASUREMENT_ID=
BUGMARK_GA_API_SECRET=
# Pro sign-in: Google OAuth client ID (type "Chrome extension", tied to the pinned extension ID).
# Injected into the packaged extension's manifest oauth2.client_id + CONFIG.licensing.oauthClientId.
BUGMARK_OAUTH_CLIENT_ID=

# ─── Pro licensing — Firebase Admin (Firestore) ────────────────
# Server-side credentials for verifying tokens and reading/writing users + licenses.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE JSON as a single-line string (or set GOOGLE_APPLICATION_CREDENTIALS to a file path instead).
FIREBASE_SERVICE_ACCOUNT_KEY=
# Alternatively: absolute path to the service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=

# ─── Pro licensing — Dodo Payments ─────────────────────────────
# Dodo dashboard → Developer → API keys. Use the test key locally, live key in production.
DODO_API_KEY=
# API base: https://test.dodopayments.com (test) or https://live.dodopayments.com (live).
DODO_API_BASE=https://test.dodopayments.com
# The one-time "Bugmark Pro" product id (Dodo dashboard → Products).
DODO_PRODUCT_ID=
# Webhook signing secret (Dodo dashboard → Webhooks). Verified with the Standard Webhooks scheme.
DODO_WEBHOOK_SECRET=

# ─── Search engines ────────────────────────────────────────────
# Google Search Console → Add property → HTML tag → the content="…" value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag → the content="…" value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
